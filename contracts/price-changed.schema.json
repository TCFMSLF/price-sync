{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/price-changed.v1.json",
  "title": "PriceChanged",
  "description": "Событие изменения цены товара в ERP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "source",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Уникальный идентификатор события, ключ дедупликации"
    },
    "eventType": {
      "const": "price.changed",
      "description": "Тип события"
    },
    "schemaVersion": {
      "const": 1,
      "description": "Версия контракта события"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Время изменения цены в UTC, RFC 3339"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Идентификатор запроса для трассировки"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Система-источник события"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "priceVersion", "oldPrice", "newPrice", "currency"],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "description": "Идентификатор товара, ключ сообщения Kafka"
        },
        "priceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Новая версия цены товара, монотонно возрастает при каждом изменении"
        },
        "oldPrice": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$",
          "description": "Цена до изменения, строка с двумя знаками после запятой"
        },
        "newPrice": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$",
          "description": "Цена после изменения, строка с двумя знаками после запятой"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Валюта, три заглавные буквы"
        }
      }
    }
  }
}
