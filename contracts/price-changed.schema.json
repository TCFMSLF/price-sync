{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PriceChangedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "source",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "price.changed"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "oldPrice",
        "newPrice",
        "currency",
        "priceVersion"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "oldPrice": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "newPrice": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "priceVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}