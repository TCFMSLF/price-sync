KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PRICE_UPDATES=price-updates
KAFKA_CONSUMER_GROUP=catalog-price-sync

OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.05
OUTBOX_RETRY_MAX_SECONDS=30

ERP_DATABASE_URL=postgresql+psycopg://price_sync:price_sync@localhost:5433/erp
CATALOG_DATABASE_URL=postgresql+psycopg://price_sync:price_sync@localhost:5433/catalog
CATALOG_SEED_FILE=data/products.json
CONSUMER_POLL_TIMEOUT_SECONDS=0.05
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_DELAY_SECONDS=1
LATENCY_WINDOW_SIZE=100
